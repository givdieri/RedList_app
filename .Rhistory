required_pkgs <- c("dplyr", "readr", "readxl", "stringr", "tidyr", "tibble")
missing_pkgs <- required_pkgs[!vapply(required_pkgs, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing_pkgs) > 0) {
message("Installing missing R packages: ", paste(missing_pkgs, collapse = ", "))
tryCatch(
install.packages(missing_pkgs, repos = "https://cloud.r-project.org"),
error = function(e) {
stop(
"Package installation failed (likely due to blocked CRAN in this environment). ",
"Install Ubuntu r-cran-* packages for: ", paste(missing_pkgs, collapse = ", "),
". Original error: ", conditionMessage(e),
call. = FALSE
)
}
)
}
suppressPackageStartupMessages({
library(dplyr)
library(readr)
library(readxl)
library(stringr)
library(tidyr)
})
# -----------------------------
# Config (v1 defaults)
# -----------------------------
raw_data_path <- "data_raw/funbel/Data_updated.txt"
raw_sheet <- "Data genera"
lookup_path <- "spatial/tblIFBLkwartier.csv"
ecodistrict_path <- "spatial/tblIFBLkwartierhokEcodistrict.csv"
output_dir <- "app_data"
year_min_default <- 1800L
year_max_default <- as.integer(format(Sys.Date(), "%Y"))
required_record_columns_any <- c("Species", "Genus", "Soortnaam", "Datum")
required_lookup_any <- c("ifbluurhok", "IFBLuur", "IFBL")
# -----------------------------
# Helpers
# -----------------------------
normalize_ifbl <- function(x) {
x |>
as.character() |>
str_trim() |>
str_replace_all("\\.", "-") |>
str_to_lower()
}
derive_ifbluurhok <- function(ifbluurhok, uurhok, kwartier) {
ifbl <- normalize_ifbl(ifbluurhok)
fallback <- paste0(normalize_ifbl(uurhok), "-", as.character(kwartier))
fallback <- str_replace_all(fallback, "--", "-")
fallback <- ifelse(grepl("^-$|^na-|^-na$|^na-na$", fallback), NA_character_, fallback)
dplyr::coalesce(ifbl, fallback)
}
extract_year <- function(date_raw, year_raw = NULL) {
year_num <- suppressWarnings(as.integer(year_raw))
date_char <- as.character(date_raw)
parsed <- suppressWarnings(as.Date(date_char))
parsed_year <- suppressWarnings(as.integer(format(parsed, "%Y")))
parsed_dmy <- suppressWarnings(as.Date(date_char, format = "%d/%m/%Y"))
parsed_dmy_year <- suppressWarnings(as.integer(format(parsed_dmy, "%Y")))
year_from_string <- suppressWarnings(as.integer(str_extract(date_char, "\\b(17|18|19|20)\\d{2}\\b")))
dplyr::coalesce(year_num, parsed_year, parsed_dmy_year, year_from_string)
}
is_unresolved_taxon <- function(species) {
sp <- species |> as.character() |> str_squish()
sp == "" |
is.na(sp) |
str_detect(sp, regex("(^|\\s)sp\\.?($|\\s)", ignore_case = TRUE)) |
str_detect(sp, regex("(^|\\s)spp\\.?($|\\s)", ignore_case = TRUE))
}
first_present <- function(df, candidates) {
present <- intersect(candidates, names(df))
if (length(present) == 0) return(NULL)
present[[1]]
}
stop_missing_cols <- function(df, required_cols, label) {
missing_cols <- setdiff(required_cols, names(df))
if (length(missing_cols) > 0) {
stop(label, " is missing required columns: ", paste(missing_cols, collapse = ", "), call. = FALSE)
}
}
read_delimited_auto <- function(path) {
ext <- tolower(tools::file_ext(path))
delim <- switch(
ext,
"txt" = "\t",
"tsv" = "\t",
"csv" = ";",
NA_character_
)
if (is.na(delim)) {
first_line <- readLines(path, n = 1, warn = FALSE)
if (length(first_line) == 0 || !nzchar(first_line)) {
stop("Input file appears empty: ", path, call. = FALSE)
}
if (str_detect(first_line, "\\t")) {
delim <- "\t"
} else if (str_detect(first_line, ";")) {
delim <- ";"
} else if (str_detect(first_line, ",")) {
delim <- ","
} else {
stop(
"Could not infer delimiter for file: ", path,
". Expected tab, semicolon, or comma-separated text.",
call. = FALSE
)
}
}
out <- readr::read_delim(
path,
delim = delim,
locale = locale(encoding = "UTF-8"),
show_col_types = FALSE,
trim_ws = TRUE
) |>
as_tibble()
if (ext == "csv" && ncol(out) == 1) {
alt <- readr::read_delim(
path,
delim = ",",
locale = locale(encoding = "UTF-8"),
show_col_types = FALSE,
trim_ws = TRUE
) |>
as_tibble()
if (ncol(alt) > ncol(out)) {
out <- alt
}
}
out
}
load_main_records <- function(path, sheet = NULL) {
if (!file.exists(path)) {
stop("Raw data file not found: ", path, call. = FALSE)
}
ext <- tolower(tools::file_ext(path))
if (ext %in% c("xlsx", "xls")) {
return(readxl::read_excel(path, sheet = sheet) |> as_tibble())
}
if (ext %in% c("txt", "tsv", "csv")) {
return(read_delimited_auto(path))
}
stop(
"Unsupported input format for raw data file: ", path,
". Supported: .xlsx, .xls, .txt, .tsv, .csv",
call. = FALSE
)
}
pick_or_na_chr <- function(df, col) if (col %in% names(df)) as.character(df[[col]]) else rep(NA_character_, nrow(df))
pick_or_na_num <- function(df, col) if (col %in% names(df)) suppressWarnings(as.numeric(df[[col]])) else rep(NA_real_, nrow(df))
# -----------------------------
# Read source files
# -----------------------------
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
records_raw <- load_main_records(raw_data_path, raw_sheet)
lookup_raw <- read_delimited_auto(lookup_path)
ecodistrict_raw <- if (file.exists(ecodistrict_path)) {
read_delimited_auto(ecodistrict_path)
} else {
tibble()
}
problems(records_raw)
str(lookup_raw)
str(records_raw)
# -----------------------------
# Validate input columns
# -----------------------------
stop_missing_cols(records_raw, required_record_columns_any, "Raw records")
lookup_ifbl_col <- first_present(lookup_raw, required_lookup_any)
if (is.null(lookup_ifbl_col)) {
stop("Lookup is missing IFBL field. Expected one of: ", paste(required_lookup_any, collapse = ", "), call. = FALSE)
}
# -----------------------------
# Prepare lookup tables
# -----------------------------
lookup_flanders <- lookup_raw |>
mutate(ifbluurhok = normalize_ifbl(.data[[lookup_ifbl_col]])) |>
filter(!is.na(ifbluurhok), ifbluurhok != "") |>
distinct(ifbluurhok, .keep_all = TRUE)
ifbl_col_eco <- first_present(ecodistrict_raw, c("IFBLuurhok", "ifbluurhok"))
ecoreg_col <- first_present(ecodistrict_raw, c("REGIO", "Ecoregio"))
ecodist_col <- first_present(ecodistrict_raw, c("DISTRICT", "Ecodistrict"))
ecodistrict_lookup <- tibble(
ifbluurhok = normalize_ifbl(if (!is.null(ifbl_col_eco)) ecodistrict_raw[[ifbl_col_eco]] else character()),
Ecoregio = if (!is.null(ecoreg_col)) as.character(ecodistrict_raw[[ecoreg_col]]) else character(),
Ecodistrict = if (!is.null(ecodist_col)) as.character(ecodistrict_raw[[ecodist_col]]) else character()
) |>
filter(!is.na(ifbluurhok), ifbluurhok != "") |>
distinct(ifbluurhok, .keep_all = TRUE)
# -----------------------------
# Clean records (v1: keep raw validatie, no hard validatie filtering)
# -----------------------------
records_clean <- records_raw |>
mutate(
record_id = row_number(),
Species = as.character(Species),
Genus = as.character(Genus),
Soortnaam = as.character(Soortnaam),
Datum = as.character(Datum),
validatie = pick_or_na_chr(records_raw, "validatie"),
Old_name = dplyr::coalesce(pick_or_na_chr(records_raw, "Old_name"), paste(Genus, Soortnaam)),
ifbluurhok = derive_ifbluurhok(
pick_or_na_chr(records_raw, "ifbluurhok"),
pick_or_na_chr(records_raw, "Uurhok"),
pick_or_na_chr(records_raw, "Kwartier")
),
year = extract_year(Datum, pick_or_na_chr(records_raw, "Year")),
species_working = Species,
source_dataset = pick_or_na_chr(records_raw, "Source.Name"),
species_original = Species,
species_accepted = species_working,
genus = Genus,
dutch_name = pick_or_na_chr(records_raw, "Nednaam"),
date_original = Datum,
validation_status = validatie,
place = pick_or_na_chr(records_raw, "Plaats"),
terrain = dplyr::coalesce(pick_or_na_chr(records_raw, "Terrein"), pick_or_na_chr(records_raw, "terreinifbl_id")),
substrate = pick_or_na_chr(records_raw, "Substraat"),
ecology_group = pick_or_na_chr(records_raw, "Eco1Groep"),
Eco1 = pick_or_na_chr(records_raw, "Eco1"),
Eco1Groep = pick_or_na_chr(records_raw, "Eco1Groep"),
observer = pick_or_na_chr(records_raw, "Waarnemer"),
determiner = pick_or_na_chr(records_raw, "Determinator")
)
excluded <- records_clean |>
transmute(
record_id,
species = species_working,
ifbluurhok,
year,
exclusion_reason = case_when(
is_unresolved_taxon(species_working) ~ "unresolved_taxon",
is.na(year) ~ "year_missing_or_unparseable",
year < year_min_default | year > year_max_default ~ "year_out_of_range",
is.na(ifbluurhok) | ifbluurhok == "" ~ "ifbl_missing",
TRUE ~ NA_character_
)
) |>
filter(!is.na(exclusion_reason))
records_clean <- records_clean |>
left_join(excluded |> select(record_id, exclusion_reason), by = "record_id") |>
mutate(include_in_analysis = is.na(exclusion_reason))
# -----------------------------
# Recreate Flemish joined analysis table (legacy condensAllVL behaviour)
# -----------------------------
records_analysis_base <- records_clean |>
filter(include_in_analysis) |>
inner_join(lookup_flanders, by = "ifbluurhok") |>
left_join(ecodistrict_lookup, by = "ifbluurhok")
records_analysis <- records_analysis_base |>
transmute(
record_id,
Species = species_accepted,
species_working = species_accepted,
ifbluurhok,
Year = as.integer(year),
IFBLuur = dplyr::coalesce(pick_or_na_chr(records_analysis_base, "IFBLuur"), pick_or_na_chr(records_analysis_base, "IFBL"), ifbluurhok),
Xcoord = pick_or_na_num(records_analysis_base, "Xcoord"),
Ycoord = pick_or_na_num(records_analysis_base, "Ycoord"),
Ecoregio,
Ecodistrict,
validatie,
Source.Name = source_dataset,
Code = pick_or_na_chr(records_analysis_base, "Code"),
Genus,
Soortnaam,
Nednaam = pick_or_na_chr(records_analysis_base, "Nednaam"),
Plaats = place,
Terrein = terrain,
Kwartier = pick_or_na_chr(records_analysis_base, "Kwartier"),
Datum,
Waarnemer = observer,
Determinator = determiner,
Herbarium = pick_or_na_chr(records_analysis_base, "Herbarium"),
Substraat = substrate,
Wetnaam = pick_or_na_chr(records_analysis_base, "Wetnaam"),
kommentaar = pick_or_na_chr(records_analysis_base, "kommentaar"),
Eco1,
Eco1Groep,
Old_name,
species_original,
source_dataset
)
species_master <- records_clean |>
filter(!is.na(species_accepted), species_accepted != "") |>
group_by(species_accepted) |>
summarise(
genus = dplyr::first(na.omit(genus)),
dutch_name = dplyr::first(na.omit(dutch_name)),
old_name_example = dplyr::first(na.omit(Old_name)),
n_records_total = n(),
n_records_included = sum(include_in_analysis),
.groups = "drop"
) |>
arrange(species_accepted)
taxon_audit <- records_clean |>
count(species_original, species_accepted, sort = TRUE, name = "n_records")
settings_defaults <- tibble::tribble(
~setting_key, ~setting_value, ~description,
"split_year", "2000", "Historical <= split year; current > split year.",
"dd_grid_threshold", "5", "DD default when occupied IFBL grids < threshold in both periods.",
"criterion_a_cr_decline", "-80", "Criterion A CR decline threshold (%).",
"criterion_a_en_decline", "-50", "Criterion A EN decline threshold (%).",
"criterion_a_vu_decline", "-30", "Criterion A VU decline threshold (%).",
"criterion_a_no_trend_common_fraction", "0.75", "Legacy noTrend commonness fraction.",
"year_min", as.character(year_min_default), "Minimum accepted year in preprocessing.",
"year_max", as.character(year_max_default), "Maximum accepted year in preprocessing."
)
# -----------------------------
# Write outputs
# -----------------------------
saveRDS(records_clean, file.path(output_dir, "records_clean.rds"))
saveRDS(records_analysis, file.path(output_dir, "records_analysis.rds"))
saveRDS(species_master, file.path(output_dir, "species_master.rds"))
saveRDS(lookup_flanders, file.path(output_dir, "lookup_flanders_ifbl.rds"))
saveRDS(ecodistrict_lookup, file.path(output_dir, "lookup_ecodistrict.rds"))
readr::write_csv(excluded, file.path(output_dir, "excluded_records.csv"))
readr::write_csv(taxon_audit, file.path(output_dir, "taxon_audit.csv"))
readr::write_csv(settings_defaults, file.path(output_dir, "settings_defaults.csv"))
message("Preprocessing completed.")
message("records_clean: ", nrow(records_clean))
message("records_analysis: ", nrow(records_analysis))
message("species_master: ", nrow(species_master))
message("excluded_records: ", nrow(excluded))
shiny::runApp('.')
library(shiny)
install.packages("shiny")
shiny::runApp('.')
install.packages("DT")
shiny::runApp('.')
install.packages("markdown")
shiny::runApp('.')
