position = position_stack(vjust = 0.5),
size = 3.5,
fontface = "bold",
color = "white") +
coord_flip() +
theme_minimal() +
labs(title = "Country distribution (ISO2 codes)",
x = NULL,
y = "Count",
fill = "Country") +
theme(
legend.position = "none",
axis.text.y = element_blank(),
panel.grid = element_blank()
)
print(p_bar)
# Prepare data: group small countries as "Others"
bar_data <- country_counts2 %>%
mutate(
iso2_plot = ifelse(n < 4, "Others", iso2),
country_plot = ifelse(n < 4, "Others", country)
) %>%
group_by(iso2_plot, country_plot) %>%
summarise(n = sum(n), .groups = "drop") %>%
arrange(desc(n)) %>%
mutate(
prop = n / sum(n),
label = paste0(iso2_plot, "\n", round(prop * 100, 1), "%")
)
# Create horizontal stacked bar chart
p_bar <- ggplot(bar_data, aes(x = "", y = n, fill = iso2_plot)) +
geom_col(width = 0.7, color = "white", linewidth = 0.5) +
geom_text(aes(label = label),
position = position_stack(vjust = 0.5),
size = 3.5,
fontface = "bold",
color = "white") +
coord_flip() +
theme_minimal() +
labs(title = "Country distribution (ISO2 codes)",
x = NULL,
y = "Count",
